### VRU Marketplace — backend configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# EVERY VALUE BELOW IS A PLACEHOLDER. None of them is a real secret, and none of them is
# safe to deploy. Generate each secret with `openssl rand -hex 32`.
#
# The app validates all of this at boot (src/config/env.validation.ts). A missing or
# malformed variable stops the process and says which one, rather than failing later on the
# one request that happened to need it.

# --- Runtime ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database ---------------------------------------------------------------------------
# The database password docker-compose.yml gives Postgres and builds the API's DATABASE_URL from.
# Required — compose refuses to start without it, and the postgres container refuses this
# placeholder before creating its volume. Hex only (`openssl rand -hex 32`), because it is spliced
# into a URL. Postgres reads it only when its data volume is first created.
POSTGRES_PASSWORD=replace-me-openssl-rand-hex-32

# Read by the app and, via prisma.config.ts, by the Prisma CLI — when they run on the host.
# Under Docker Compose the API's DATABASE_URL is built from POSTGRES_PASSWORD instead and this line
# is ignored; to reach the compose database from the host (docker-compose.dev.yml), point this at
# localhost with that same password.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/vru_marketplace

# --- First super admin (K2) -------------------------------------------------------------
# The seed creates or promotes this account. Safe to re-run: it is an identity to look up,
# not a row to blindly insert.
SUPER_ADMIN_EMAIL=admin@example.com

# --- PDPA deletion markers (K16) --------------------------------------------------------
# Pepper for HMAC(email) in DeletedAccountMarker.
#
# ⚠️ THIS VALUE CAN NEVER BE ROTATED. Markers are the only trace of an erased account and
# the old digests cannot be recomputed — change this and everyone who was ever banned can
# register again. Keep it out of the database, and keep it in the backup plan.
ACCOUNT_MARKER_PEPPER=replace-me-openssl-rand-hex-32-at-least-32-chars

# --- Cookies and CSRF (B3) --------------------------------------------------------------
# Both tokens live in httpOnly cookies and are never returned in a response body.
# Three different keys. Reusing one means a token minted for one purpose is valid for another.
#
# ⚠️ IN USE SINCE #24. The placeholders below are long enough to pass validation, and anyone
# who has read this file could mint a session cookie for any account with them — so with
# NODE_ENV=production (always, under docker-compose.yml) the app refuses to start while ANY value
# in this file still contains `replace-me` (§99). In development they boot as they are.
# The session table stores HMACs keyed with these, so replacing one signs everybody out: that
# is the expected cost, and it is why they are worth generating once, properly, at install.
ACCESS_TOKEN_SECRET=replace-me-openssl-rand-hex-32-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-me-openssl-rand-hex-32-at-least-32-chars
CSRF_SECRET=replace-me-openssl-rand-hex-32-at-least-32-chars

# Signs the single-use links sent by email (verification · password reset). A separate key
# again: a link in somebody's inbox is a temporary password for their account.
# Rotating this invalidates links already in flight — one "resend" for whoever was mid-flow.
VERIFICATION_TOKEN_SECRET=replace-me-openssl-rand-hex-32-at-least-32-chars

# --- Uploads (K1) -----------------------------------------------------------------------
# Directory backed by a Docker volume. Files are served only through an endpoint that checks
# permissions — never exposed as an Nginx path.
#
# ⚠️ Never concatenate user input onto this path.
UPLOAD_DIR=/var/lib/vru-marketplace/uploads

# The one size ceiling every image upload obeys (#36) — bytes. Defaults to 10MB (C4).
MAX_IMAGE_UPLOAD_BYTES=10485760

# §100 — uploads wait on disk here while their request lasts, never in memory, and are deleted as
# the response closes. Defaults to the OS temp directory; outside UPLOAD_DIR on purpose.
# UPLOAD_TMP_DIR=/tmp/vru-marketplace-upload-scratch

# §100 — how many images are decoded/re-encoded at once, system-wide, and how long an upload waits
# for a turn before it is answered 503 + Retry-After. One full dispute measured ≈200MiB above idle,
# so raise the first only together with the container's memory limit (API_MEMORY_LIMIT).
IMAGE_PROCESSING_CONCURRENCY=2
IMAGE_PROCESSING_QUEUE_TIMEOUT_MS=20000

# --- Email (A4 · §107) -------------------------------------------------------------------
# Only ever read behind the single EmailSender interface. EMAIL_TRANSPORT picks the provider:
#   brevo — Brevo's API (needs BREVO_API_KEY)
#   smtp  — an SMTP account, e.g. the university's own mail system (needs the four SMTP_* below)
# Only the chosen one's settings are required; the other's may stay as they are here.
EMAIL_TRANSPORT=brevo
BREVO_API_KEY=replace-me-with-a-brevo-api-key

# SMTP: 587 upgrades with STARTTLS, 465 is TLS from the start — TLS is required either way, and a
# server that offers none is refused rather than sent the password. Ask the university's IT for an
# account made for the system (noreply@...), not a person's own mailbox.
SMTP_HOST=replace-me.smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me@example.com
SMTP_PASSWORD=replace-me-with-the-smtp-password

# Must be an address the chosen provider may send as (on Brevo: a verified sender; on SMTP: usually
# the SMTP account itself).
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=VRU Marketplace

# --- Frontend ---------------------------------------------------------------------------
# Base URL used to build links in verification and password-reset emails (I16 · B0.1).
# The real domain is still undecided (issue #20); SPF/DKIM have to be set up there before
# these emails will reach an inbox instead of a spam folder.
FRONTEND_BASE_URL=http://localhost:5173

# --- Sign in with Google (#26) ----------------------------------------------------------
# Create an "OAuth client ID" of type "Web application" in Google Cloud Console, with the
# scopes `openid` and `email` only.
#
# GOOGLE_REDIRECT_URI points at THIS BACKEND, not at the frontend, and must be registered
# there as an authorised redirect URI character for character — Google compares the string,
# so a trailing slash or http-vs-https is enough to fail with redirect_uri_mismatch.
#
# ⚠️ The secret never reaches a browser: the backend trades Google's code for the token
# itself and sets the usual httpOnly cookies (B3).
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me-with-the-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# --- Rate limits (#28 · I17 · L7) --------------------------------------------------------
# Ceilings on the endpoints somebody can guess at or spam. All of them are windows that
# reopen on their own: NOTHING HERE EVER LOCKS AN ACCOUNT, because a lock is a tool for
# locking other people out of theirs (I17).
#
# ⚠️ TRUST_PROXY_HOPS is the number of reverse proxies actually in front of this process —
# 1 for the Nginx in CLAUDE.md, 0 when running the app directly. The limits are counted per
# source address, and at 0 behind a proxy the whole site shares one counter and locks itself
# out. Setting it HIGHER than the truth is worse: X-Forwarded-For is a header any client can
# write, so an over-trusting setting lets callers pick their own address and their own
# allowance.
TRUST_PROXY_HOPS=1

# Per (IP + email). This marketplace is open to the public rather than a closed population, so
# a counter kept by IP alone would let one person on a shared address (mobile CGNAT, public
# wifi, an office router) lock out everybody else behind the same one (N18).
RATE_LIMIT_LOGIN_PER_15_MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_EMAIL_LINK_PER_HOUR=3

# Per IP, and deliberately looser than anything above. Three cases: the reset form carries no
# address to count against; registration and login are both endpoints where picking a new
# address costs an attacker nothing (a fresh email, or somebody else's, per attempt) — so each
# per-IP ceiling sits ON TOP of its (IP + email) twin above, never instead of it. All three
# numbers are guesses rather than anything I17 or L7 decided; raise them if real users hit them.
RATE_LIMIT_LOGIN_PER_IP_PER_HOUR=60
RATE_LIMIT_REGISTER_PER_IP_PER_HOUR=20
RATE_LIMIT_PASSWORD_RESET_PER_IP_PER_HOUR=20

# §100 — uploads per ACCOUNT per hour, every upload route together (not per IP: a campus behind one
# router is not one person). One request = one upload — a dispute's 10 photos count once, a product's
# 10 photos (one request each) count 10. The project owner's number; raise it if sellers adding a
# catalogue hit it.
RATE_LIMIT_UPLOAD_PER_HOUR=60
