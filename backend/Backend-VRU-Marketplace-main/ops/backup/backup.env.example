# Copy to backup.env and fill in real values — backup.env is gitignored, this file is not.
# See README.md for what each of these does and why.

# Full path to this repo on the host that runs `docker compose`.
COMPOSE_PROJECT_DIR=/opt/vru-marketplace

# ⚠️ MUST be a different disk/mount than the one Docker itself runs on — a NAS mount, a
# second physical disk, or a synced object-storage path. Backing up onto the same disk as
# the original is not a backup: both copies fail together.
BACKUP_DEST_DIR=/mnt/CHANGE-ME-to-a-separate-disk-or-NAS-path/vru-marketplace-backups

# How many days of daily runs to keep before deleting the oldest. 30 covers D5b's 15-day
# dispute window twice over — see README.md "ทำไม 30 วัน" for the full reasoning. Safe to
# change; only affects future cleanup, never existing backups.
RETENTION_DAYS=30

# Must match .env's own DATABASE_URL for this deployment.
POSTGRES_DB=vru_marketplace
POSTGRES_USER=postgres

# How stale the last successful backup may get before check-backup-health.sh calls it broken.
# 36 = a daily run plus half a day of slack, so one late run stays quiet but a skipped one
# does not. Raise it if backup.sh is scheduled less often than daily.
MAX_AGE_HOURS=36

# Compose service names — only change these if docker-compose.yml's own service names change.
POSTGRES_SERVICE=postgres
API_SERVICE=api
